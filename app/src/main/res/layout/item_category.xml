<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="92dp"
    android:layout_margin="4dp"
    android:background="@drawable/category_tile"
    android:clickable="true" android:focusable="true"
    android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/catEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="30sp" />
    <TextView android:id="@+id/catLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" />
</LinearLayout>
