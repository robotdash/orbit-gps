<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
    <!-- Garmin-style arrow: which way the place is from where you're heading -->
    <ImageView android:id="@+id/placeArrow" android:layout_width="30dp" android:layout_height="30dp"
        android:layout_marginEnd="14dp" android:contentDescription="@null" android:src="@drawable/ic_dir_arrow"
        android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/placeName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/placeDetail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/panel_subtext" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/placeDist" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:textColor="@color/accent" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
