<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The car arrow: drawn over the map and moved every frame for smooth motion -->
    <ImageView
        android:id="@+id/carArrow"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_car_arrow"
        android:visibility="gone" />

    <!-- "Where to?" bar (when not navigating) -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/panel_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/menuBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu"
            app:tint="#FFFFFF" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/where_to"
            android:textColor="@color/panel_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- One-tap shortcuts under "Where to?" -->
    <HorizontalScrollView
        android:id="@+id/quickChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="102dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quickChipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />
    </HorizontalScrollView>

    <!-- Results shown as pins on the map: what they are, back to the list, close -->
    <LinearLayout
        android:id="@+id/mapResultsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="102dp"
        android:background="@drawable/chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mapResultsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mapResultsList"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/show_list"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mapResultsClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/close"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Turn banner (while navigating) -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/banner_bg"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/turnIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/turn_straight" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/turnDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/turnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#E6F0FF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- lane boxes, filled in from code -->
        <LinearLayout
            android:id="@+id/laneRow"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/thenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/panel_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Junction picture (exits, forks, lanes, roundabouts). Its height comes from
             the picture; the countdown bar just follows it. -->
        <FrameLayout
            android:id="@+id/junctionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="-12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/junctionImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/junction_picture"
                android:scaleType="fitCenter" />

            <com.robotdash.orbitgps.CountdownBar
                android:id="@+id/junctionBar"
                android:layout_width="8dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginVertical="10dp"
                android:layout_marginEnd="8dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Speed box, bottom left -->
    <LinearLayout
        android:id="@+id/speedBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_placeholder"
            android:textColor="@color/panel_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/starting"
            android:textColor="@color/panel_subtext"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Buttons, right side -->
    <LinearLayout
        android:id="@+id/fabColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">




        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/nearbyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/nearby"
            android:src="@drawable/ic_search"
            android:visibility="gone"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/muteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/mute"
            android:src="@drawable/ic_voice"
            android:visibility="gone"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/orient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/orientation"
            android:src="@drawable/ic_heading_up"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/recenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/recenter"
            android:src="@drawable/ic_recenter"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom bar while navigating: arrival time, distance, time left, stop -->
    <LinearLayout
        android:id="@+id/navBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/banner_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/navSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/panel_subtext"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/stopBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop" />
    </LinearLayout>

    <!-- Route preview card -->
    <LinearLayout
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/previewInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/panel_subtext"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/goBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/go"
                android:textSize="18sp" />

            <Button
                android:id="@+id/simBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:text="@string/simulate" />

            <Button
                android:id="@+id/saveBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:text="@string/save"
                android:textColor="@color/accent" />

            <Button
                android:id="@+id/cancelBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:text="@android:string/cancel"
                android:textColor="@color/panel_subtext" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search panel (full screen): the "Where to?" menu -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/search_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/panel_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/searchBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/panel_subtext"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/searchClear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Browse: shown when the box is empty -->
        <ScrollView
            android:id="@+id/browseScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/quickRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/homeBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/home"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/workBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/work"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Your 3 shortcuts (shown on the main screen): hold a place type below and drag it here -->
                <TextView
                    style="@style/MenuHeader"
                    android:text="@string/shortcuts_header" />

                <TextView
                    android:id="@+id/shortcutsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="6dp"
                    android:text="@string/shortcuts_hint"
                    android:textColor="#B8C4D6"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/shortcutSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/MenuHeader"
                    android:text="@string/find_places" />

                <GridLayout
                    android:id="@+id/categoryGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:columnCount="3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/MenuHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/saved_places" />

                    <Button
                        android:id="@+id/manageSavedBtn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/manage"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/savedList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/recentHeader"
                    style="@style/MenuHeader"
                    android:text="@string/recents_header" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Results: shown when typing or after picking a category -->
        <LinearLayout
            android:id="@+id/resultsHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- List | Map: show these results as pins -->
            <TextView
                android:id="@+id/resultsMapBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="9dp"
                android:text="@string/show_on_map"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textColor="@color/panel_subtext"
            android:textSize="15sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/searchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
